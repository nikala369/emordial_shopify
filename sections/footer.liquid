{%- style -%}
  .footer-logo img {
    max-width: 85px;
    height: auto;
  }

  .footer-payment-icons img {
    max-height: 30px;
    margin-right: 0.5rem;
  }

  .back-to-top {
    display: inline-block;
    margin: 50px auto 20px;
    cursor: pointer;
    text-align: center;
    transition: transform 0.3s ease
    , color 0.3s ease;
  }

  .back-to-top:hover,
  .back-to-top:focus {
    transform: scale(1.2);
    color: #ffffff;
  }

  .footer-menu-heading {
    color: #ffffff;
    margin-bottom: 1rem;
    font-size: 2rem;
  }

  .footer-menu-link {
    color: #cccccc;
    transition: color 0.3s ease;
    margin-bottom: 0.25rem;
    font-size: 16px;
    padding: 0.5rem 0;
  }

  .footer-menu-link:hover,
  .footer-menu-link:focus {
    color: #ffffff;
    text-decoration: underline;
  }

  .footer-text {
    text-align: center;
    color: #cccccc;
    margin-top: 2rem;
    font-size: 14px;
  }

  .footer-text a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-text a:hover {
    text-decoration: underline;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .grid-space-on-mobile {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .footer-logo img {
      max-width: 70px;
    }
  }
{%- endstyle -%}

<footer style="background-color: black; color: white; padding: 32px 0;">
  <div style="max-width: 1280px; margin: auto; padding: 0 16px;">

    <!-- Logo -->
    <div class="footer-logo" style="display: flex; justify-content: center; align-items: center; margin-bottom: 16px;">
      {% if section.settings.footer_logo != blank %}
        <a href="/" title="Back to Home">
          <img
            src="{{ section.settings.footer_logo | img_url: 'master' }}"
            alt="{{ shop.name | escape }}"
            style="max-width: 85px; height: auto;">
        </a>
      {% else %}
        <a href="/" title="Back to Home">
          <p class="footer-default-text" style="color: #ffffff;">Your Logo Here</p>
        </a>
      {% endif %}
    </div>

    <!-- Menus and Social Media Links -->
    <div class="grid-space-on-mobile">
<pre>{{ section }}</pre>
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'link_list' %}
            <div>
              <h2 class="footer-menu-heading">{{ block.settings.heading }}</h2>
              {% assign menu = menus[block.settings.menu] %}
              {% if menu.links != blank %}
                <ul style="list-style: none; padding: 0;">
                  {% for link in menu.links %}
                    <li class="footer-menu-link">
                      <a href="{{ link.url }}" style="color: #cccccc; text-decoration: none;">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <p>Menu is empty or not assigned.</p>
              {% endif %}
            </div>
          {% when 'text' %}
            <!-- Custom Text Block -->
            <div>
              <h2 class="footer-menu-heading">{{ block.settings.heading }}</h2>
              <div class="footer-text">{{ block.settings.text }}</div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <!-- Payment Icons -->
    {% if section.settings.show_payment_icons %}
      <div class="footer-payment-icons" style="display: flex; justify-content: center; margin-bottom: 24px;">
        {% for type in shop.enabled_payment_types %}
          <span class="payment-icon" style="margin-right: 0.5rem;">
            {{ type | payment_type_svg_tag: class: 'h-8' }}
          </span>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Copyright and Policies -->
    <div class="footer-text" style="text-align: center; margin-top: 32px; font-size: 14px;">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      <div style="margin-top: 4px;">
        <a href="{{ routes.root_url }}/policies/terms-of-service" style="color: #cccccc; text-decoration: none;">Terms & policies</a>
        |
        <a href="{{ routes.root_url }}/policies/privacy-policy" style="color: #cccccc; text-decoration: none;">Privacy policy</a>
        |
        <a href="{{ routes.root_url }}/pages/brand-guidelines" style="color: #cccccc; text-decoration: none;">Brand guidelines</a>
      </div>
    </div>

  </div>
</footer>


{% schema %}
  {
    "name": "Custom Footer",
    "max_blocks": 6,
    "blocks": [
      {
        "type": "link_list",
        "name": "Link Block",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Explore"
          }, {
            "type": "link_list",
            "id": "menu",
            "label": "Footer Menu",
            "info": "Select a menu to display in the footer."
          }
        ]
      }, {
        "type": "text",
        "name": "Custom Text",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "About Us"
          }, {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Your custom HTML here</p>"
          }
        ]
      }
    ],
    "settings": [
      {
        "type": "image_picker",
        "id": "footer_logo",
        "label": "Footer Logo"
      }, {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Show Payment Icons",
        "default": true
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Padding Top",
        "default": 30
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Default Footer",
        "category": "Footer"
      }
    ]
  }
{% endschema %}