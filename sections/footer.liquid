{%- style -%}
  .grid-space-on-mobile {
    display: flex;
    justify-content: space-between;
    margin-bottom: 55px;
    margin-top: 25px;


    @media (max-width: 768px) {
      flex-direction: row;
      padding: 10px;
    }
  }

  .div-block-footer {
    width: 200px;

    @media (max-width: 768px) {
      width: auto;
    }
  }

  .ul-style {
    list-style-type: none;
    padding: 0;
    margin: 0;

    width: 150px;

    @media (max-width: 768px) {
      width: auto;
    }
  }

  .ul-style li {
    margin-bottom: 0.25rem;
  }

  .footer-logo img {
    max-width: 85px;
    height: auto;

    @media (max-width: 768px) {
      width: 60px;
    }
  }

  @media (max-width: 767px) {
    #footerLogo {
      display: none;
      /* Hide logo on mobile */
    }
  }

  @media (min-width: 768px) {
    #footerLogo {
      display: flex;
      /* Show logo on desktop */
      justify-content: center;
      align-items: center;
    }
  }

  @media (min-width: 767px) {
    #footerLogoMobile {
      display: none;
      /* Hide logo on mobile */
    }
  }

  @media (max-width: 768px) {
    #footerLogoMobile {
      display: flex;
      /* Show logo on desktop */
      justify-content: center;
      align-items: center;
    }
  }

  .footer-payment-icons img {
    max-height: 30px;
    margin-right: 0.5rem;
  }

  .back-to-top {
    display: inline-block;
    margin: 50px auto 20px;
    cursor: pointer;
    text-align: center;
    transition: transform 0.3s ease
    , color 0.3s ease;
    background-color: black;
    /* Set background color to black */
    color: white;
    /* Set text/icon color to white */
    border: none;
    /* Remove any borders */
    padding: 10px 20px;
    /* Add some padding */
    border-radius: 5px;
  }

  .back-to-top:hover,
  .back-to-top:focus {
    transform: scale(1.1);
    /* Slightly increase the size on hover/focus */
    color: white;
    /* Maintain white color for text/icon on hover/focus */
  }

  .back-to-top svg {
    fill: white;
    /* Set SVG icon color to white */
  }

  .back-to-top:hover svg,
  .back-to-top:focus svg {
    fill: white;
    /* Maintain the SVG icon color as white on hover/focus */
  }

  .button-container {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }

  .footer-menu-heading {
    color: #ffffff;
    margin-bottom: 1rem;
    font-size: 2rem;
    font-family: 'Montserrat'
    , sans-serif;
    letter-spacing: 1px;
    font-weight: 600;

    @media (max-width: 768px) {
      font-size: 1.6rem;
    }
  }

  .follow-us-block-header-mobile {
    display: block;
    @media (max-width: 768px) {
      display: none;
    }

  }

  .social-icons-margin {
  @media (max-width: 768px) {
    margin-top: 25px;
  }
}

.footer-menu-link {
  color: #cccccc;
  transition: color 0.3s ease
  , transform 0.3s ease;
  font-size: 16px;
  padding: 0.5rem 0;
  text-decoration: none;
  display: block;
  /* Make the link fill the li element */
  width: 100%;
  /* Ensure the link uses the full width */
  position: relative;

  @media (max-width: 768px) {
    font-size: 13px;
  }
}

.footer-menu-link::after {
  content: '';
  position: absolute;
  width: 100%;
  /* Full width of the parent */
  height: 2px;
  background-color: #ffffff;
  left: 0;
  bottom: 0;
  transition: transform 0.3s ease;
  transform: scaleX(0);
  transform-origin: bottom right;
}

.footer-menu-link:hover,
.footer-menu-link:focus {
  color: #ffffff;
}

.footer-menu-link:hover::after,
.footer-menu-link:focus::after {
  transform: scaleX(1);
  transform-origin: bottom left;
}

.footer-text a {
  color: #cccccc;
  /* Text color remains constant */
  text-decoration: none;
  position: relative;
  transition: color 0.2s ease-in-out;
}

.footer-text a::after {
  content: '';
  position: absolute;
  width: 0;
  height: 2px;
  /* Thickness of the underline */
  bottom: -5px;
  /* Position of the underline */
  left: 50%;
  background-color: #ffffff;
  /* Color of the underline */
  transition: width 0.2s ease-in-out
  , left 0.2s ease-in-out;
}

.footer-text a:hover::after,
.footer-text a:focus::after {
  width: 100%;
  left: 0;
}

.footer-text a:hover,
.footer-text a:focus {
  color: white;
  /* Keeps the text color the same as the non-hover state */
}


.social-media-links {
  width: 35px;
}

.social-media-links .facebook-icon {
  color: #1877f2;
  /* Facebook Blue */
}

.social-media-links .twitter-icon {
  color: #1da1f2;
  /* Twitter Blue */
}

.social-media-links .instagram-icon {
  background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%);
}

.padding-top-li {
  padding-top: 10px;
}

.icon-tiktok {
  color: white;
}

{%- endstyle -%}

<footer style="background-color: black; color: white; padding: 32px 0;">
  <div style="max-width: 1280px; margin: auto; padding: 0 16px;">

    <!-- Logo -->
    <div class="footer-logo" id="footerLogoMobile">
      {% if section.settings.footer_logo != blank %}
        <a href="/" title="Back to Home">
          <img
            class="footer-logo"
            src="{{ section.settings.footer_logo | img_url: 'master' }}"
            alt="{{ shop.name | escape }}">
        </a>
      {% else %}
        <a href="/" title="Back to Home">
          <p class="footer-default-text" style="color: #ffffff;">Your Logo Here</p>
        </a>
      {% endif %}
    </div>

    <!-- Menus and Social Media Links -->
    <div class="grid-space-on-mobile">

      <!-- Logo -->
      <div class="footer-logo" id="footerLogo">
        {% if section.settings.footer_logo != blank %}
          <a href="/" title="Back to Home">
            <img
              class="footer-logo"
              src="{{ section.settings.footer_logo | img_url: 'master' }}"
              alt="{{ shop.name | escape }}">
          </a>
        {% else %}
          <a href="/" title="Back to Home">
            <p class="footer-default-text" style="color: #ffffff;">Your Logo Here</p>
          </a>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'link_list' %}
            <div class="div-block-footer">
              <h2 class="footer-menu-heading">{{ block.settings.heading }}</h2>
              {% assign menu = menus[block.settings.menu] %}
              {% if menu %}
                {% if menu.links != blank %}
                  <ul class="ul-style">
                    {% for link in menu.links %}
                      <li>
                        <a href="{{ link.url }}" class="footer-menu-link">{{ link.title }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% else %}
                  <p>Menu "{{ block.settings.menu }}" is assigned but has no links.</p>
                {% endif %}
              {% else %}
                <p>Menu "{{ block.settings.menu }}" not found.</p>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}


      {% comment %} social media icons render {% endcomment %}
      <div class="div-block-footer">
        <h1 class="footer-menu-heading follow-us-block-header-mobile">FOLLOW US</h1>
        <ul class="ul-style social-icons-margin">
          <li class="padding-top-li">
            <a
              style="display: inline-block;"
              href="{{ section.settings.facebook_link }}"
              class="social-link"
              target="_blank">
              <div class="social-media-links">
                {% render 'icon-facebook' %}
              </div>
            </a>
          </li>

          <li class="padding-top-li">
            <a
              style="display: inline-block;"
              href="{{ section.settings.twitter_link }}"
              class="social-link"
              target="_blank">
              <div class="social-media-links">
                {% render 'icon-tiktok' %}
              </div>
            </a>
          </li>

          <li class="padding-top-li">
            <a
              style="display: inline-block;"
              href="{{ section.settings.instagram_link }}"
              class="social-link"
              target="_blank">
              <div class="social-media-links">
                {% render 'icon-instagram' %}
              </div>
            </a>
          </li>
        </ul>
      </div>


    </div>

    <!-- Payment Icons -->
    {% if section.settings.show_payment_icons %}
      <div class="footer-payment-icons" style="display: flex; justify-content: center; margin-bottom: 24px;">
        {% for type in shop.enabled_payment_types %}
          <span class="payment-icon" style="margin-right: 0.5rem;">
            {{ type | payment_type_svg_tag: class: 'h-8' }}
          </span>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Copyright and Policies -->
    <div class="footer-text" style="text-align: center; margin-top: 32px; font-size: 14px;">
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      <div style="margin-top: 4px;">
        <a href="{{ routes.root_url }}/policies/terms-of-service">Terms & policies</a>
        |
        <a href="{{ routes.root_url }}/policies/privacy-policy">Privacy policy</a>
        |
        <a href="{{ routes.root_url }}/pages/brand-guidelines">Brand guidelines</a>
      </div>
    </div>

    <div class="button-container">
      <button class="back-to-top" id="backToTop">
        {% render 'icon-up-arrow' %}
      </button>
    </div>


  </div>
</footer>


{% schema %}
  {
    "name": "Footer",
    "settings": [
      {
        "type": "image_picker",
        "id": "footer_logo",
        "label": "Footer Logo",
        "info": "Upload your logo. It will be displayed at the top of the footer."
      }, {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Show Payment Icons",
        "default": true,
        "info": "Display payment icons at the bottom of the footer."
      }
    ],
    "blocks": [
      {
        "type": "link_list",
        "name": "Menu",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Menu Heading",
            "default": "Explore"
          }, {
            "type": "link_list",
            "id": "menu",
            "label": "Select Menu",
            "info": "Choose a menu to display in this block."
          }
        ],
        "limit": 4
      }
    ],
    "presets": [
      {
        "name": "Default Footer",
        "category": "Footer",
        "blocks": [
          {
            "type": "link_list"
          }
        ]
      }
    ]
  }
{% endschema %}


<script>
    document.getElementById('backToTop').addEventListener('click', function(event) {
        event.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
</script>