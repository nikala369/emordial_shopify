{% style %}
  .about-us-wrapper {
    text-align: center;
    margin-top: 20px;
  }

  .about-us-title {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .about-us-description {
    font-size: 1.2rem;
    color: #666;
    margin-bottom: 2rem;
  }

  .team-section {
    margin-top: 3rem;
  }

  .team-heading {
    font-size: 1.8rem;
    margin-bottom: 2rem;
  }

  .team-list {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }

  .team-member {
    margin: 0 20px;
    text-align: center;
    max-width: 200px;
  }

  .team-photo {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin-bottom: 1rem;
  }

  .team-name {
    font-weight: bold;
    font-size: 1.2rem;
  }

  .team-role {
    font-size: 1rem;
    color: #999;
  }
{% endstyle %}

<div class="about-us-wrapper section-{{ section.id }}-padding">
  <div class="page-width page-width--narrow">
    <h1 class="about-us-title page-title h0 business-emordial-title{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ section.settings.heading | escape }}
    </h1>

    {% if section.settings.show_description %}
      <p class="about-us-description">
        {{ section.settings.description | escape }}
      </p>
    {% endif %}

    {% if section.settings.show_team %}
      <div class="team-section">
        <h2 class="team-heading">Meet Our Team</h2>
        <ul class="team-list">
          <div>test</div>
        </ul>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
  {
    "name": "About Us",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "About Us"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Welcome to Emordial. Our mission is to deliver high-quality jewelry with timeless designs. We are committed to excellence and craftsmanship."
      }, {
        "type": "checkbox",
        "id": "show_description",
        "label": "Show Description",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_team",
        "label": "Show Team Section",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "team_member",
        "name": "Team Member",
        "settings": [
          {
            "type": "image_picker",
            "id": "photo",
            "label": "Photo"
          }, {
            "type": "text",
            "id": "name",
            "label": "Name",
            "default": "John Doe"
          }, {
            "type": "text",
            "id": "role",
            "label": "Role",
            "default": "Founder & CEO"
          }
        ]
      }
    ]
  }
{% endschema %}