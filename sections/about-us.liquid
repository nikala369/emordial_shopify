{%- style -%}
  .about-section {
    padding: 20px;
    text-align: center;
  }
  .about-content-wrapper {
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.8;
    color: #333;
    font-size: 18px;
  }
  .about-image {
    max-width: 100%;
    margin: 20px 0;
  }
{%- endstyle -%}

<section class="about-section">
  <div class="about-content-wrapper">
    {% if section.settings.image %}
      <img
        src="{{ section.settings.image | file_url }}"
        alt="{{ section.settings.heading }}"
        class="about-image">
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.description }}</p>
  </div>
</section>

{% schema %}
  {
    "name": "About Us Content",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "About Emordial"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Welcome to Emordial! Here is where we share our story, mission, and values."
      }, {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      }
    ]
  }
{% endschema %}