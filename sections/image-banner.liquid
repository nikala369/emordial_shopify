}

/* Down arrow styling for mobile only */
.down-arrow {
  position: absolute;
  z-index: 4;
  bottom: -35px;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
  width: 20px;
  height: 20px;
  border-left: 3px solid rgba(255, 255, 255, 0.9);
  /* Thicker and more visible */
  border-bottom: 3px solid rgba(255, 255, 255, 0.9);
  /* Thicker and more visible */
  opacity: 1;
  display: none;
  /* Hidden by default, visible when needed */
  outline: none;
  -webkit-tap-highlight-color: transparent;
  /* Prevent mobile highlight */
  box-shadow: 0 0 8px rgba(255, 255, 255, 0.7);
  /* Add a subtle glow */
  transition: border-color 0.3s ease
  , box-shadow 0.3s ease
  , opacity 0.4s ease;
}

/* Focus and active states for better accessibility */
.down-arrow:focus,
.down-arrow:active {
  outline: none;
  box-shadow: 0 0 12px rgba(255, 255, 255, 1);
  /* Brighter glow when active */
}

/* Animation for pulsing effect from white to light grey */
@keyframes pulse {
  0,
  100% {
    border-color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.7);
  }
  50% {
    border-color: rgba(200, 200, 200, 0.7);
    box-shadow: 0 0 10px rgba(200, 200, 200, 0.8);
  }
}

/* Apply pulse animation */
.down-arrow.pulsing {
  animation: pulse 1.5s infinite ease-in-out;
  /* Smooth pulsing effect */
}

/* Show arrow only on mobile */
@media screen and (max-width: 768px) {
  .down-arrow {
    display: block;
  }
}


