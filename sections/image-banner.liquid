  /* Base Styles for the Custom Button END */


  /* Main Banner Section Styles */.custom-banner-section {
    position: relative;
    width: 100%;
    height: calc(100vh - 8vh);
    /* Ensures the banner spans the full viewport height */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    /* Prevents any overflow issues */
    z-index: 0;

    /* Mobile-specific adjustments */
    @media screen and (max-width: 768px) {
      height: calc(100vh - 8.5vh);
      /* Slightly shorter height for smaller screens */
    }
  }

  .svg-background:empty {
    display: block;
    /* Ensure these elements are visible */
  }

  /* Overlay Wrapper */
  .svg-background-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Ensures it sits below the content */
    /* background: rgba(0, 0, 0, 0.2); */
    transition: background 0.3s ease;
    z-index: -1;
    /* Dark semi-transparent overlay */

    @media screen and (max-width: 768px) {
      /* background: rgb(93 93 93 / 30%); */
      background: rgb(255 255 255 / 57.5%);
      z-index: -1;
    }
  }

  .svg-background {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;

    width: 100%;
    height: 100%;

    background-color: #ffffff;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    opacity: 0;
    transition: opacity 0.8s ease
    , background-image 0.2s ease;
  }

  #background-image.loaded {
    opacity: 1;
  }

  /* 3D Model Animation PLine */
  ._x983nf8 {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50.5%);
    width: 170px;
    /* Slightly narrower to emphasize sleekness */
    background: linear-gradient(to bottom, rgba(240, 240, 240, 0) 0%, /* Subtle transparency at the edges */ rgba(255, 255, 255, 0.8) 25%, /* Light gradient progression */ rgba(255, 255, 255, 1) 50%, /* Bright white in the center */ rgba(255, 255, 255, 0.8) 75%, /* Gradual fade */ rgba(240, 240, 240, 0) 100% /* Subtle transparency at the edges */);
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.05), /* Subtle outer glow */
    inset 0 0 5px rgba(0, 0, 0, 0.1);
    /* Minimal inner shadow for depth */
    animation: portalFadeIn 1.5s linear forwards;
    /* Linear, smooth appearance */
    z-index: 1;
    opacity: 0.85;
    /* Slight transparency for an ethereal look */

    border-top: 0;
    border-bottom: 0;

    @media screen and (max-width: 768px) {
      width: 80%;
    }
  }

  @keyframes portalFadeIn {
    0% {
      height: 0;
      /* Start from the top */
      opacity: 0;
      /* Fully transparent */
    }
    100% {
      height: 38vh;
      /* Expand to full height */
      opacity: 0.85;
      /* Smooth final transparency */
    }
  }

  /* 3D Model Container */
  #model-container {
    position: absolute;
    top: 23.5%;
    /* Positioned above the center */
    left: 50%;
    transform: translate(-50%, -50%);
    /* Center aligned */
    z-index: 10;

    /* Mobile adjustments */
    @media screen and (max-width: 768px) {
      top: 22.5%;
      /* Slightly adjusted for smaller screens */
    }
  }

  /* Shop Now and text h1 wrap  */
  .button-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    position: relative;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;


    @media screen and (max-width: 768px) {
      top: 45.5%
    }
  }

  /* Button Styles */
  .shop-now-button-main {
    display: inline-block;
    margin-top: 6rem;
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: #000;
    border: 2px solid #000;
    text-decoration: none;
    /* border-radius: 4px; */
    transition: background-color 0.3s ease
    , color 0.3s ease;
    font-family: 'Montserrat'
    , sans-serif;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 1.2rem;

    position: relative;
    z-index: 2;

    @media screen and (max-width: 750px) {
      padding: 0.5rem 1rem;
      font-size: 1rem;


      /*
   border: 2px solid white;
   color: white;
*/
    }

  }

  .shop-now-button-main:hover,
  .shop-now-button-main:focus {
    background-color: #000;
    /* Background becomes black on hover */
    color: #fff;
    /* Text color changes to white on hover */

    @media screen and (max-width: 750px) {
      background-color: transparent;
      color: transparent;
    }
  }

  .banner-subtitle {
    color: #333;
    /* Strong black for contrast */
    font-size: 2.5rem;
    /* Slightly smaller than the title */
    font-family: 'mont-semibold';
    text-align: center;
    margin: 0 0 5px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.2)
    , 0 0 10px rgba(0, 0, 0, 0.15)
    , 0 0 15px rgba(0, 0, 0, 0.1);
    user-select: none;

    @media screen and (max-width: 750px) {
      width: 100vw;
      font-size: 1.7rem;
      letter-spacing: 3px;


      /*
   color: #fff;
   text-shadow: 0 0 5px rgba(255, 255, 255, 0.7)
   , 0 0 10px rgba(255, 255, 255, 0.7)
   , 0 0 15px rgba(255, 255, 255, 0.7);
*/
    }
  }

  .banner-title {
    color: #000;
    font-size: 5rem;
    font-family: 'mont-bold';
    text-align: center;
    margin: 0 auto;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 500;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.2)
    , 0 0 10px rgba(0, 0, 0, 0.15)
    , 0 0 15px rgba(0, 0, 0, 0.1);
    user-select: none;

    @media screen and (max-width: 750px) {
      width: 100vw;
      font-size: 2.4rem;


      /*
   color: #fff;
   text-shadow: 0 0 5px rgba(255, 255, 255, 0.7)
   , 0 0 10px rgba(255, 255, 255, 0.7)
   , 0 0 15px rgba(255, 255, 255, 0.7);
*/
    }
  }

  /* Down Arrow */
  .down-arrow {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%) rotate(-45deg);
    width: 20px;
    height: 20px;
    border-left: 2px solid rgba(255, 255, 255, 0.9);
    border-bottom: 2px solid rgba(255, 255, 255, 0.9);
    z-index: 3;
    opacity: 0;
    animation: fadeInArrow 1s 1.5s ease forwards
    , pulse 1.5s infinite ease-in-out;
  }

  /* Down Arrow animations */
  @keyframes fadeInArrow {
    to {
      opacity: 1;
      /* Fully visible */
    }
  }

  @keyframes pulse {
    0,
    100% {
      transform: translateX(-50%) rotate(-45deg) scale(1);
      /* Normal size */
    }
    50% {
      transform: translateX(-50%) rotate(-45deg) scale(1.1);
      /* Slightly larger */
    }
  }

  /* Ensure arrow visibility on mobile */
  @media screen and (max-width: 768px) {
    .down-arrow {
      display: block;
    }
  }

{%- endstyle -%}


<div id="Banner-{{ section.id }}" class="custom-banner-section section-{{ section.id }}-padding">
  <!-- PLine for 3D model animation -->
  {% comment %} <div class="_x983nf8">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <span style="opacity: 0;">.</span>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </div> {% endcomment %}

  <!-- SVG Background Overlay -->

  <div class="svg-background" id="background-image">

    <div class="svg-background-overlay">
      <!-- 3D Model Container -->
      <div id="model-container" class="model-container"></div>
      <!-- Button Wrapper -->
      <div class="button-wrapper">
        {% if section.settings.subtitle_text %}
          <h2 class="banner-subtitle">{{ section.settings.subtitle_text }}</h2>
        {% endif %}

        {% if section.settings.heading_text %}
          <h1 class="banner-title">{{ section.settings.heading_text }}</h1>
        {% endif %}

        <a href="{{ section.settings.button_link }}" class="shop-now-button-main">
          {{ section.settings.button_label }}
        </a>
      </div>
    </div>

  </div>

  <!-- Down Arrow -->
  <div class="down-arrow" id="down-arrow"></div>
</div>

<script>
      document.addEventListener("DOMContentLoaded", function () {
      const modelContainer = document.getElementById('model-container');
      
      setTimeout(() => {
    document.body.classList.add("loaded");
      }, 100);

      if (!modelContainer) {
    console.error('3D Model container not found');
    return;
      }

      // Dynamic sizing for different devices
      const isMobile = window.innerWidth < 768;
      const isMobileLocal = window.matchMedia("(max-width: 768px)").matches;

      // Detect initial load for main banner animation
  const isHardRefresh = !sessionStorage.getItem("pageLoaded");

  // Save a flag to prevent reanimation on subsequent refreshes
  if (isHardRefresh) {
  sessionStorage.setItem("pageLoaded", "true");
  }

      // other component part start
      const desktopImage = "{{ section.settings.desktop_svg | image_url }}";
      const mobileImage = "{{ section.settings.mobile_svg | image_url }}";
      const backgroundImageElement = document.getElementById("background-image");

      const loadBackgroundImage = () => {
  const imageToLoad = isMobileLocal ? mobileImage : desktopImage;

  const img = new Image();
  img.src = imageToLoad;

  img.onload = () => {
    backgroundImageElement.style.backgroundImage = `url(${imageToLoad})`;

    if (isHardRefresh) {
      // Apply fade-in only on hard refresh
      setTimeout(() => {
        backgroundImageElement.classList.add("loaded");
      }, 15);
    } else {
      // Skip fade-in for other refreshes
      backgroundImageElement.classList.add("loaded");
    }
  };
  };

  // Initial load
  loadBackgroundImage();

  // Update background on resize without fade-in
  window.addEventListener("resize", () => {
  loadBackgroundImage();
  });
      // other component part END
      

      const size = isMobile ? 120 : 140;
      modelContainer.style.width = `${size}px`;
      modelContainer.style.height = `${size}px`;

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setPixelRatio(window.devicePixelRatio);
      renderer.setSize(size, size);
      renderer.outputEncoding = THREE.sRGBEncoding;
      modelContainer.appendChild(renderer.domElement);

      const scene = new THREE.Scene();
      const aspectRatio = modelContainer.clientWidth / modelContainer.clientHeight;
      const camera = new THREE.PerspectiveCamera(isMobile ? 45 : 40, aspectRatio, 0.1, 1000);
      camera.position.set(0, 0.4, 4);

      const controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableZoom = false;
      controls.enablePan = false;
      controls.autoRotate = false;
      controls.maxDistance = 4.7;
      controls.minDistance = 3.5;

      // 🔹 Restrict Vertical Movement (No Up/Down) NEW
  controls.minPolarAngle = Math.PI / 2; 
  controls.maxPolarAngle = Math.PI / 2;

      window.addEventListener('resize', function () {
    const isMobile = window.innerWidth < 768;
    const size = isMobile ? 120 : 140;
    modelContainer.style.width = `${size}px`;
    modelContainer.style.height = `${size}px`;
    renderer.setSize(size, size);
    camera.aspect = modelContainer.clientWidth / modelContainer.clientHeight;
    camera.updateProjectionMatrix();
      });

      const hoverEffect = { isHovering: false, angle: 0 };
      modelContainer.addEventListener('mouseenter', () => {
        // true custom change
    hoverEffect.isHovering = false;
      });
      modelContainer.addEventListener('mouseleave', () => {
    hoverEffect.isHovering = false;
    // resetHoverEffect(); old animation custom change
    checkCameraLimits();
      });
      modelContainer.addEventListener('touchstart', () => {
        // true custom change
    hoverEffect.isHovering = false;
      });
      modelContainer.addEventListener('touchend', () => {
    hoverEffect.isHovering = false;
    checkCameraLimits();
      });

      function checkCameraLimits() {
  // Define vertical movement boundaries
  const maxY = 0.6;   // Maximum upward movement
  const minY = -0.2;  // Maximum downward movement

  if (camera.position.y > maxY || camera.position.y < minY) {
    startRecenteringAnimationMobile();
  }
  }

      function resetHoverEffect() {
      // Applying smooth transition for both desktop and mobile
      gsap.to(hoverEffect, {
    angle: 0,
    onUpdate: () => {
      if (gltfModel) {
        gltfModel.rotation.y = hoverEffect.angle;
      }
    },
    onComplete: () => {
      gsap.to(camera.position, {
        duration: 1,
        x: 0,
        y: 0.6,
        z: 4,
        ease: "power3.out", // Using 'power3.out' for a smooth deceleration
        onUpdate: () => controls.update()
      });
    }
      });
      }

      // duration - 0.8, y: 0.6 custom change
      function startRecenteringAnimationMobile() {
    gsap.to(camera.position, {
    duration: 0.7,
    x: 0,
    y: 0.4,
    z: 4,
    ease: "power3.out", // Ensures a smooth but quick transition back to the center
    onStart: () => {
      if (gltfModel) {
        // Adjust model rotation slightly for a smoother look
        gsap.to(gltfModel.rotation, {
          y: 0,
          duration: 0.7,
          ease: "power1.inOut"
        });
      }
    },
    onUpdate: () => controls.update()
      });
      }

      // Improved lighting configuration
      const ambientLight = new THREE.AmbientLight(0x404040, 0.6);  // Increased ambient light for softer shadows
      scene.add(ambientLight);

      const directionalLight = new THREE.DirectionalLight(0xC0C0C0, 0.8);  // Slightly reduced intensity
      directionalLight.position.set(-1, 2, 4);  // Modified position for more even illumination
      scene.add(directionalLight);

      const fillLight = new THREE.DirectionalLight(0xB0B0B0, 0.5);  // Additional fill light to soften dark areas
      fillLight.position.set(2, -1, -2);
      scene.add(fillLight);

      let gltfModel = null;
      const loader = new THREE.GLTFLoader();
      loader.load('{{ 'model-emordial-logo.gltf' | asset_url }}', function (gltf) {
    scene.add(gltf.scene);
    gltfModel = gltf.scene;
    gltf.scene.traverse(function (object) {
      if (object.isMesh) {
        object.material.metalness = 1;
        object.material.roughness = 0.1;
        object.material.color.setHex(0x101010);
        object.scale.set(0.6, 0.6, 0.4);
      }
    });

    // Trigger fade-in after model is fully loaded
    modelContainer.style.transition = 'opacity 0.5s';
    modelContainer.style.opacity = '1';

    // Enhanced initial animation to indicate interactivity
       gsap.fromTo(gltfModel.rotation, { y: -0.3 }, { y: 0.3, repeat: 1, yoyo: true, duration: 0.25, ease: "power1.inOut", onComplete: () =>
       gsap.to(gltfModel.rotation, { y: 0, duration: 0.25, ease: "power1.inOut" }) });

      }, undefined, function (error) {
    console.error('An error happened during the loading of the model:', error);
      });
      

      modelContainer.style.opacity = '0';

      let rotationDelay = true;

  // Set a timeout to allow rotation to start after 2 seconds
  setTimeout(() => {
  rotationDelay = false;
  }, 1400);

      function animate() {
    requestAnimationFrame(animate);
    // !isMobile
    // && hoverEffect.isHovering
    if (!rotationDelay) {
      hoverEffect.angle += 0.015;
      if (gltfModel) {
        gltfModel.rotation.y = hoverEffect.angle;
      }
    }
    controls.update();
    renderer.render(scene, camera);
      }
      animate();
      });


      document.addEventListener("DOMContentLoaded", function() {
    const downArrow = document.getElementById('down-arrow');

      // Show the arrow with pulse effect after 2 seconds on mobile devices
      if (window.innerWidth <= 768) {
      setTimeout(() => {
    downArrow.style.display = 'block';
    downArrow.classList.add('pulsing');
      }, 1400); // 1.4 sec
      }

       // arrow clicked
       downArrow.addEventListener('click', function (event) {
    event.preventDefault();
    downArrow.style.display = 'none';
    window.scrollBy({
      top: window.innerHeight - 50,
      behavior: 'smooth',
    });
      });

      // Hide arrow down test41
      window.addEventListener('scroll', function () {
      if (window.scrollY > 40) {
    downArrow.style.display = 'none';
      }
      });

       // Manage scroll restoration to always start from the top on page load
       if ('scrollRestoration' in history) {
    history.scrollRestoration = 'manual'; // Prevent browser from remembering scroll position
      }

    // Select the banner, header, and announcement bar elements
    const banner = document.querySelector('.custom-margin-banner-section');
    const header = document.querySelector('.header-wrapper--border-bottom');
    const announcementBar = document.querySelector('.shopify-section-group-header-group');

    // Function to update banner height for mobile devices
    function updateBannerHeight() {
        const headerHeight = header ? header.offsetHeight : 0;
        const announcementHeight = announcementBar ? announcementBar.offsetHeight : 0;
        const totalHeight = headerHeight + announcementHeight + 69;  // Extra padding to account for margins

        // Set banner height to 100vh minus the height of the header and announcement bar
        const bannerHeight = window.innerHeight - totalHeight;
        banner.style.height = `${bannerHeight}px`;

    }

    // Check if screen width is under 800px and update banner height only during initial page load
    function checkScreenWidth() {
        if (window.innerWidth <= 800) {
            updateBannerHeight();
        } else {
            banner.style.height = 'auto';
        }
    }

    // Initial check for screen width and set height accordingly
    // checkScreenWidth();

    // Remove resize event listener after setting the height on page load
    // So the banner height won't change after the page has rendered
    window.removeEventListener('resize', checkScreenWidth);
      });
</script>


{% schema %}
  {
    "name": "Image Banner",
    "settings": [
      {
        "type": "image_picker",
