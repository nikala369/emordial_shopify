  <div class="down-arrow" id="down-arrow"></div>
</div>

<script>
      document.addEventListener("DOMContentLoaded", function () {
      const modelContainer = document.getElementById('model-container');
      
      setTimeout(() => {
    document.body.classList.add("loaded");
      }, 100);

      if (!modelContainer) {
    console.error('3D Model container not found');
    return;
      }

      // Dynamic sizing for different devices
      const isMobile = window.innerWidth < 768;
      const size = isMobile ? 190 : 260;
      modelContainer.style.width = `${size}px`;
      modelContainer.style.height = `${size}px`;

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setPixelRatio(window.devicePixelRatio);
      renderer.setSize(size, size);
      renderer.outputEncoding = THREE.sRGBEncoding;
      modelContainer.appendChild(renderer.domElement);

      const scene = new THREE.Scene();
      const aspectRatio = modelContainer.clientWidth / modelContainer.clientHeight;
      const camera = new THREE.PerspectiveCamera(75, aspectRatio, 0.1, 1000);
      camera.position.set(0, 0.6, 4);

      const controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableZoom = false;
      controls.enablePan = false;
      controls.autoRotate = false;
      controls.maxDistance = 4.7;
      controls.minDistance = 3.5;

      window.addEventListener('resize', function () {
    const isMobile = window.innerWidth < 768;
    const size = isMobile ? 180 : 260;
    modelContainer.style.width = `${size}px`;
    modelContainer.style.height = `${size}px`;
    renderer.setSize(size, size);
    camera.aspect = modelContainer.clientWidth / modelContainer.clientHeight;
    camera.updateProjectionMatrix();
      });

      const hoverEffect = { isHovering: false, angle: 0 };
      modelContainer.addEventListener('mouseenter', () => {
    hoverEffect.isHovering = true;
      });
      modelContainer.addEventListener('mouseleave', () => {
    hoverEffect.isHovering = false;
    resetHoverEffect();
      });
      modelContainer.addEventListener('touchstart', () => {
    hoverEffect.isHovering = true;
      });
      modelContainer.addEventListener('touchend', () => {
    hoverEffect.isHovering = false;
    startRecenteringAnimationMobile();
      });

      function resetHoverEffect() {
      // Applying smooth transition for both desktop and mobile
      gsap.to(hoverEffect, {
    angle: 0,
    onUpdate: () => {
      if (gltfModel) {
        gltfModel.rotation.y = hoverEffect.angle;
      }
    },
    onComplete: () => {
      gsap.to(camera.position, {
        duration: 1,
        x: 0,
        y: 0.6,
        z: 4,
        ease: "power3.out", // Using 'power3.out' for a smooth deceleration
        onUpdate: () => controls.update()
      });
    }
      });
      }

      function startRecenteringAnimationMobile() {
    gsap.to(camera.position, {
    duration: 0.8,
    x: 0,
    y: 0.6,
    z: 4,
    ease: "power3.out", // Ensures a smooth but quick transition back to the center
    onStart: () => {
      if (gltfModel) {
        // Adjust model rotation slightly for a smoother look
        gsap.to(gltfModel.rotation, {
          y: 0,
          duration: 0.7,
          ease: "power1.inOut"
        });
      }
    },
    onUpdate: () => controls.update()
      });
      }

      // Improved lighting configuration
      const ambientLight = new THREE.AmbientLight(0x404040, 0.6);  // Increased ambient light for softer shadows
      scene.add(ambientLight);

      const directionalLight = new THREE.DirectionalLight(0xC0C0C0, 0.8);  // Slightly reduced intensity
      directionalLight.position.set(-1, 2, 4);  // Modified position for more even illumination
      scene.add(directionalLight);

      const fillLight = new THREE.DirectionalLight(0xB0B0B0, 0.5);  // Additional fill light to soften dark areas
      fillLight.position.set(2, -1, -2);
      scene.add(fillLight);

      let gltfModel = null;
      const loader = new THREE.GLTFLoader();
      loader.load('{{ 'emordial-animation.gltf' | asset_url }}', function (gltf) {
    scene.add(gltf.scene);
    gltfModel = gltf.scene;
    gltf.scene.traverse(function (object) {
      if (object.isMesh) {
        object.material.metalness = 0.95;
        object.material.roughness = 0.05;
        object.material.color.setHex(0x101010);
        object.scale.set(0.6, 0.6, 0.4);
      }
    });

    // Trigger fade-in after model is fully loaded
    modelContainer.style.transition = 'opacity 0.5s';
    modelContainer.style.opacity = '1';

    // Enhanced initial animation to indicate interactivity
       gsap.fromTo(gltfModel.rotation, { y: -0.3 }, { y: 0.3, repeat: 1, yoyo: true, duration: 0.4, ease: "power1.inOut", onComplete: () =>
       gsap.to(gltfModel.rotation, { y: 0, duration: 0.4, ease: "power1.inOut" }) });

      }, undefined, function (error) {
    console.error('An error happened during the loading of the model:', error);
      });
      

      modelContainer.style.opacity = '0';

      function animate() {
    requestAnimationFrame(animate);
    if (!isMobile && hoverEffect.isHovering) {
      hoverEffect.angle += 0.02;
      if (gltfModel) {
        gltfModel.rotation.y = hoverEffect.angle;
      }
    }
    controls.update();
    renderer.render(scene, camera);
      }
      animate();
      });


      document.addEventListener("DOMContentLoaded", function() {
    const downArrow = document.getElementById('down-arrow');

      // Show the arrow with pulse effect after 2 seconds on mobile devices
      if (window.innerWidth <= 768) {
      setTimeout(() => {
    downArrow.style.display = 'block';
    downArrow.classList.add('pulsing');
      }, 1400); // 1.4 sec
      }

       // arrow clicked
       downArrow.addEventListener('click', function (event) {
    event.preventDefault();
    downArrow.style.display = 'none';
    window.scrollBy({
      top: window.innerHeight - 50,
      behavior: 'smooth',
    });
      });

      // Hide arrow down test41
      window.addEventListener('scroll', function () {
      if (window.scrollY > 40) {
    downArrow.style.display = 'none';
      }
      });

       // Manage scroll restoration to always start from the top on page load
       if ('scrollRestoration' in history) {
    history.scrollRestoration = 'manual'; // Prevent browser from remembering scroll position
      }

    // Select the banner, header, and announcement bar elements
    const banner = document.querySelector('.custom-margin-banner-section');
    const header = document.querySelector('.header-wrapper--border-bottom');
    const announcementBar = document.querySelector('.shopify-section-group-header-group');

    // Function to update banner height for mobile devices
    function updateBannerHeight() {
        const headerHeight = header ? header.offsetHeight : 0;
        const announcementHeight = announcementBar ? announcementBar.offsetHeight : 0;
        const totalHeight = headerHeight + announcementHeight + 69;  // Extra padding to account for margins

        // Set banner height to 100vh minus the height of the header and announcement bar
        const bannerHeight = window.innerHeight - totalHeight;
        banner.style.height = `${bannerHeight}px`;

    }

    // Check if screen width is under 800px and update banner height only during initial page load
    function checkScreenWidth() {
        if (window.innerWidth <= 800) {
            updateBannerHeight();
        } else {
            banner.style.height = 'auto';
        }
    }

    // Initial check for screen width and set height accordingly
    checkScreenWidth();

    // Remove resize event listener after setting the height on page load
    // So the banner height won't change after the page has rendered
    window.removeEventListener('resize', checkScreenWidth);
      });
</script>


