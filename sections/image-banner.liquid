        "label": "Button Label",
        "default": "Shop Now"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      }
    ],
    "blocks": [
      {
        "type": "heading",
        "name": "Heading",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading Text",
            "default": "Your Heading Here"
          }, {
            "type": "select",
            "id": "heading_size",
            "label": "Heading Size",
            "options": [
              {
                "value": "h1",
                "label": "H1"
              }, {
                "value": "h2",
                "label": "H2"
              }, {
                "value": "h3",
                "label": "H3"
              }
            ],
            "default": "h1"
          }
        ]
      }, {
        "type": "button",
        "name": "Button",
        "settings": [
          {
            "type": "text",
            "id": "button_label",
            "label": "Button Label",
            "default": "Shop Now"
          }, {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Image Banner",
        "blocks": [
          {
            "type": "heading"
          }, {
            "type": "button"
          }
        ]
      }
    ]
  }
{% endschema %}