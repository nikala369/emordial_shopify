{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: 15px;
    padding-right: 15px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: 0;
      padding-right: 0;
    }
  }

  @media screen and (min-width: 1200px) {
    .section-{{ section.id }}-padding {
      padding-left: 0;
      padding-right: 0;
    }
  }

  .title-centering-wrapper {
    text-align: center;
    width: 100%;
    margin-bottom: 1rem;
  }

  .business-emordial-title {
    display: inline-block;
    position: relative;
    margin: 0 auto;
    padding: 0.5rem 1rem;
    font-size: 20px;
    /* font-family: "GT America Condensed"; */
    font-family: 'pop-bold';
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
    color: #222;
    user-select: none;
  }

  @media screen and (min-width: 768px) {
    .business-emordial-title {
      font-size: 22px;
    }
  }


  @media screen and (min-width: 1200px) {
    .business-emordial-title {
      font-size: 24px;
    }
  }


  .business-emordial-title::after {
    content: '';
    display: block;
    width: 100%;
    height: 3px;
    border-radius: 0.5px;
    background: linear-gradient(to right, #970101, #ff0000, #970101);
    background-size: 200% 100%;
    animation: metallicShine 5s linear infinite;
    position: absolute;
    bottom: -5px;
    left: 0;
  }

  @keyframes metallicShine {
    0% {
      background-position: 100% center;
    }
    50% {
      background-position: 0 center;
    }
    100% {
      background-position: 100% center;
    }
  }

  .privacy-policy-subtitle {
    text-align: center;
    color: #666;
    font-size: 16px;
    margin-bottom: 2rem;
    font-style: italic;
  }

  .rte {
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.8;
    color: #333;
    font-size: 18px;
  }

  @media screen and (min-width: 768px) {
    .rte {
      max-width: 800px;
    }
  }

  .roboto-font {
    font-family: 'mont-medium';
    font-weight: 400;
    font-size: 11.5px;
    color: #000;

    @media screen and (min-width: 768px) {
      font-size: 13px;
    }
  }


  .footer-logo-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: white;
    padding-top: 50px;

    .footer-logo-svg {
      width: 57.5px;
      /* Adjust based on your desired size */
      height: auto;
      transition: transform 0.3s ease;

      @media screen and (min-width: 750px) {
        width: 70px;
      }
    }
  }


{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <div class="title-centering-wrapper">
    <h1 class="main-page-title page-title h0 business-emordial-title{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ page.title | escape }}
    </h1>
  </div>

  {% if page.title == 'Privacy Policy' %}
    <p class="privacy-policy-subtitle">
      Last updated: {{ 'now' | date: '%B %d, %Y' }}
    </p>
  {% endif %}

  <div class="rte page-specific-styling {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}
  {% unless page.title == 'About Us' %} roboto-font {% endunless %}">
    {{ page.content }}
  </div>

  {% unless page.title == 'About Us' or page.title == 'EMORDIAL BUSINESS' %}
    <div class="footer-logo-wrapper">
      <img
        class="footer-logo-svg"
        width="50"
        height="50"
        src="{{ 'emordial-logo-original-clear.svg' | asset_url }}"
        alt="Emordial Logo">
    </div>
  {% endunless %}
</div>


{% schema %}
  {
    "name": "Dynamic Page Section",
    "settings": [
      {
        "type": "header",
        "content": "Page Section Settings"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 36
      }
    ]
  }
{% endschema %}