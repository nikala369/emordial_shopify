{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: 15px;
    padding-right: 15px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: 40px;
      padding-right: 40px;
    }
  }

  @media screen and (min-width: 1200px) {
    .section-{{ section.id }}-padding {
      padding-left: 0;
      padding-right: 0;
    }
  }

  .title-centering-wrapper {
    text-align: center;
    width: 100%;
    margin-bottom: 1rem;
  }

  .business-emordial-title {
    display: inline-block;
    position: relative;
    margin: 0 auto;
    padding: 0.5rem 3rem;
    font-size: 32px;
    letter-spacing: 3px;
    font-weight: 600;
    color: #222;
    user-select: none;
  }

  @media screen and (min-width: 768px) {
    .business-emordial-title {
      font-size: 40px;
    }
  }

  @media screen and (min-width: 1200px) {
    .business-emordial-title {
      font-size: 45px;
    }
  }

  .business-emordial-title::after {
    content: '';
    display: block;
    width: 100%;
    height: 3px;
    border-radius: 0.5px;
    background: linear-gradient(to right, #970101, #ff0000, #970101);
    background-size: 200% 100%;
    animation: metallicShine 5s linear infinite;
    position: absolute;
    bottom: -5px;
    left: 0;
  }

  @keyframes metallicShine {
    0% {
      background-position: 100% center;
    }
    50% {
      background-position: 0 center;
    }
    100% {
      background-position: 100% center;
    }
  }

  .page-specific-styling.about-us {
    background: #f9f9f9;
    padding: 20px;
    text-align: left;
    font-size: 18px;
    line-height: 1.8;
    color: #555;
  }

  .privacy-policy-subtitle {
    text-align: center;
    color: #666;
    font-size: 16px;
    margin-bottom: 2rem;
    font-style: italic;
  }

  .rte {
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.8;
    color: #333;
    font-size: 18px;
  }

  @media screen and (min-width: 768px) {
    .rte {
      max-width: 800px;
    }
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <div class="title-centering-wrapper">
    <h1 class="main-page-title page-title h0 business-emordial-title{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ page.title | escape }}
    </h1>
  </div>

  {% if page.title == 'Privacy Policy' %}
    <p class="privacy-policy-subtitle">
      Last updated: {{ 'now' | date: '%B %d, %Y' }}
    </p>
  {% endif %}

  <div class="rte page-specific-styling {% if page.title == 'About Us' %}about-us{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ page.content }}
  </div>
</div>

{% schema %}
  {
    "name": "Dynamic Page Section",
    "settings": [
      {
        "type": "header",
        "content": "Page Section Settings"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 36
      }
    ]
  }
{% endschema %}