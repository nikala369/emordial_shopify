{% style %}
  .simple-announcement-bar {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color | default: '#000000' }};
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    position: relative;
    z-index: 10;
    font-size: 14px;
    padding: 0;
    /* Adjust line-height to something that fits the content rather than a fixed 7.5px */
    line-height: 1;
    /* Disable pointer events if the bar is not meant to be clickable */
    pointer-events: none;
  }

  .announcement-text {
    white-space: nowrap;
    overflow: hidden;
    width: 100%;
    background: black;
    color: white;
  }

  @keyframes slide-in {
    from {
      transform: translateX(0%);
    }
    to {
      transform: translateX(-100%);
    }
  }

  .animation-for-announcment {
    display: inline-block;
    padding-left: 100%;
    animation: slide-in 18s linear infinite;
    font-size: 12.5px;
    @media screen and (max-width: 750px) {
      font-size: 12px;
    }
  }
{% endstyle %}


<div class="simple-announcement-bar">
  <div class="announcement-text {{section.settings.text_align}}">
    <div class="animation-for-announcment">
      {{ section.settings.text }}
    </div>
  </div>
</div>


{% schema %}
  {
    "name": "Announcement",
    "settings": [
      {
        "type": "richtext",
        "id": "text",
        "label": "Text"
      }, {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#000000"
      }
    ]
  }
{% endschema %}