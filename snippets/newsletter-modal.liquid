{%- style -%}
/* Modal Base Styles */
.modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6); /* Dark background overlay */
  justify-content: center;
  align-items: center;
  transition: opacity 0.3s ease;
}

.modal-content {
  background-color: #fff;
  padding: 20px;
  max-width: 600px;
  width: 100%;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  animation: modalSlideIn 0.5s ease;
}

/* Close Button */
.modal-close {
  position: absolute;
  top: 10px;
  right: 20px;
  font-size: 24px;
  background: none;
  border: none;
  cursor: pointer;
}

/* Modal Image and Text */
.modal-image img {
  max-width: 120px;
}

.modal-heading {
  font-family: 'GT America Condensed', sans-serif;
  font-size: 2rem;
  margin: 10px 0;
  color: #333;
  text-align: center;
}

.modal-subtitle {
  font-size: 1rem;
  color: #666;
  text-align: center;
  margin-bottom: 20px;
}

/* Form Input */
.field__input {
  width: 100%;
  padding: 0 12px;
  font-size: 16px;
  border: 1px solid #ccc;
  border-radius: 4px;
  outline: none;
  box-sizing: border-box;
  margin-bottom: 10px;
  transition: border-color 0.3s ease, padding 0.3s ease;
}

.field__input:focus {
  border-color: #000;
  height: 54px;
}

.newsletter-form__label {
  position: absolute;
  left: 16px;
  top: -6px;
  font-size: 0.9rem;
  color: #888;
  transition: all 0.2s ease;
  pointer-events: none;
}

.field__input:focus + .newsletter-form__label,
.field__input:not(:placeholder-shown) + .newsletter-form__label {
  top: -18px;
  font-size: 12px;
  color: white !important;
}

.newsletter-form__button {
  padding: 12px 20px !important; 
  font-size: 1rem;
  color: white;
  background-color: black;
  border: none;
  cursor: pointer;
  border-radius: 4px; /* Softer corners for a modern touch */
  transition: background-color 0.3s ease, transform 0.2s ease; /* Added transform for subtle animation */
}

/* Hover and Focus States for better interactivity */
.newsletter-form__button:hover:not(:disabled),
.newsletter-form__button:focus:not(:disabled) {
  background-color: #333;
}

/* Disabled Button Style */
.newsletter-form__button:disabled {
  background-color: #bbb; /* Lighter gray color to give a softer appearance */
  color: #666; /* Subtle text color */
  cursor: not-allowed;
  border: 1px solid #ccc; /* Slight border for definition */
  opacity: 0.6; /* Lower opacity for a 'disabled' feel */
  transform: none; /* Prevents hover animation */
  margin-top: -23.5px;
}

/* Consent Checkbox */
.modal-consent {
  margin-top: 10px;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  color: #888; /* Light gray color for text */
  font-size: 0.90rem;
}

.modal-consent input[type='checkbox'] {
  margin-right: 8px;
  cursor: pointer;
}

/* Links within Consent */
.modal-consent a {
  color: #888;
  text-decoration: underline;
  margin-left: 4px;
  transition: color 0.3s ease;
}

.modal-consent a:hover {
  color: #333;
}

/* Mobile View */
@media (max-width: 768px) {
  .modal-content {
    width: 100%;
    height: 100vh;
    padding: 15px;
  }
}

/* Animations */
@keyframes modalSlideIn {
  from {
    transform: translateY(50px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}


{%- endstyle -%}


<div id="newsletterModal" class="modal">
  <div class="modal-content">
    <button class="modal-close" aria-label="Close modal">&times;</button>
    <div class="modal-image">
      <img src="path-to-your-image.svg" alt="Emordial Character Design" />
    </div>
    <div class="modal-text">
      <h2 class="modal-heading">Subscribe to Our Newsletter</h2>
      <p class="modal-subtitle">
        Join the Emordial family and stay updated with our latest collections
        and exclusive offers!
      </p>
      <!-- Form starts -->
      <form
        id="modalNewsletterForm"
        action="/contact#contact_form"
        method="post"
        accept-charset="UTF-8"
        class="modal-newsletter-form"
      >
        <input type="hidden" name="contact[tags]" value="newsletter" />

         <!-- Consent Checkbox -->
         <div class="modal-consent">
            <input type="checkbox" id="privacyConsent" />
            <label for="privacyConsent">
              I agree to the
              <a href="/privacy-policy" target="_blank">Privacy Policy</a> and
              <a href="/terms-of-service" target="_blank">Terms of Service</a>.
            </label>
          </div>

        <div class="newsletter-form__field-wrapper">
          <div class="field">
            <input
              id="ModalNewsletterForm--modal"
              type="email"
              name="contact[email]"
              class="field__input"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder=" "
              required
            />
            <label for="ModalNewsletterForm--modal" class="newsletter-form__label"
              >Email</label
            >
            <button
              type="submit"
              class="newsletter-form__button"
              name="commit"
              aria-label="Subscribe"
              disabled
            ></button>
          </div>
          <small
            class="newsletter-form__message form__message"
            id="ModalContactFooter-error"
          ></small>
        </div>
      </form>
      <!-- Form ends -->
    </div>
  </div>
</div>


<script>
document.addEventListener("DOMContentLoaded", function () {
  const modal = document.getElementById("newsletterModal");
  const closeModalBtn = document.querySelector(".modal-close");
  const subscribeButton = document.querySelector(".newsletter-form__button");
  const consentCheckbox = document.getElementById("privacyConsent");

  // Show modal after 15 seconds
  setTimeout(() => {
    modal.style.display = "flex";
  }, 1500);

  // Close modal function
  closeModalBtn.addEventListener("click", function () {
    modal.style.display = "none";
  });

  // Enable submit button when consent is checked
  consentCheckbox.addEventListener("change", function () {
    if (consentCheckbox.checked) {
      subscribeButton.disabled = false;
    } else {
      subscribeButton.disabled = true;
    }
  });

  // Hide modal if the user clicks outside of it
  window.onclick = function (event) {
    if (event.target == modal) {
      modal.style.display = "none";
    }
  };
});


</script>