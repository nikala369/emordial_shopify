{%- style -%}
    /* Modal Base Styles */
    .modal {
      display: none;
      position: fixed;
      z-index: 10000; /* Ensure modal is on top */
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.6); /* Dark background overlay */
      justify-content: center;
      align-items: center;
      transition: opacity 0.3s ease;
      overflow: auto; /* Enable scrolling within the modal if content overflows */
    }
    
    .modal-content {
      background-color: #fff;
      max-width: 600px;
      width: 90%; /* Responsive for mobile */
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      animation: modalSlideIn 0.5s ease;
    }
    
    /* Close Button */
    .modal-close {
      position: absolute;
      top: 17.5px;
      right: 20px;
      font-size: 24px;
      background: none;
      border: none;
      cursor: pointer;
      color: #171719;
      z-index: 10001; /* Ensure close button stays on top */

      @media (max-width: 768px) {
      right: 0px;
    }
    }
    
    /* Modal Image and Text */
    .modal-image {
      width: 100%;
      background: #DFE9C2;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    
    .modal-image img {
      max-width: 400px !important;
      width: 350px;
    }
    
    .modal-text {
      padding: 25px;
      text-align: center;
    }
    
    .modal-heading {
      font-family: 'mont-bold';
      font-size: 1.8rem;
      letter-spacing: 0.2px;
      margin: 10px 0;
      color: #333;
      margin-top: 0;

    @media (max-width: 768px) {
      font-size: 1.55rem;
      margin-top: 0px;
      margin-bottom: 10px;
    }

    }
    
    .modal-subtitle {
      font-family: 'mont-medium';
      font-size: 1rem;
      line-height: 17px;
      color: #666;
      text-align: center;
      margin-bottom: 20px;

    @media (min-width: 768px) {
      font-size: 1.2rem;
      line-height: 19px;
    }
    }
    
    /* Form Input Styles */
    .field-input-custom {
  padding: 0 20px !important;
}

.field-input-custom:focus {
  padding: 0 20px;
}



    .field__input:focus + .newsletter-form__label,
    .field__input:not(:placeholder-shown) + .newsletter-form__label {
      top: -18px;
      font-size: 12px;
    }
    
    .custom-label-focus {
      color: grey !important;
    }
    
    .field__input:focus + .custom-label-focus {
      color: white !important;
    }
    
    /* Class added when input has content */
    .label-active {
      color: white !important;
    }
    
    .newsletter-form__button-modal {
      padding: 0 25px;
      font-size: 0.9rem;
      height: 47px;
      color: #fff;
      background-color: #000;
      border: none;
      cursor: pointer;
      border-radius: 0 4px 4px 0;
      transition: background-color 0.3s ease, transform 0.2s ease;
      position: absolute;
      right: 0;
      top: 0;
      margin: 0;
    }
    
    .newsletter-form__button-modal::before {
      content: '→';
      color: white; /* Default color when enabled */
      font-size: 18px;
      display: block;
    }
    
    /* Hover and Focus States */
    .newsletter-form__button-modal:hover:not(:disabled),
    .newsletter-form__button-modal:focus:not(:disabled) {
      background-color: #333;
    }
    
    /* Disabled Button Style */
    .newsletter-form__button-modal:disabled {
      background-color: #ddd;
      cursor: not-allowed;
    }
    
    .newsletter-form__button-modal:disabled::before {
      color: #666; /* Adjusted arrow color for disabled state */
    }
    
    .modal-consent {
      margin-top: 10px;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      color: #888;

      font-family: 'pop-regular';
      font-size: 0.9rem;

      @media screen and (min-width: 768px) {
        font-size: 0.95rem;
      }
    }
    
    .modal-consent input[type='checkbox'] {
      margin-right: 8px;
      cursor: pointer;
    }
    
    /* Links within Consent */
    .modal-consent a {
      color: #888;
      text-decoration: underline;
      margin-left: 4px;
      transition: color 0.3s ease;
    }
    
    .modal-consent a:hover {
      color: #333;
    }
    
    .no-thank-you-btn {
      font-size: 1.1rem;
      font-family: 'GT America Condensed', sans-serif;
      color: #888;
      margin-top: 20px;
      cursor: pointer;
      text-align: center;
      transition: color 0.3s ease;

      @media screen and (min-width: 768px) {
      font-size: 1.2rem;
      }
    }
    
    .no-thank-you-btn:hover {
      color: #333;
    }
    
    /* Mobile View */
    @media (max-width: 768px) {
      .modal-content {
        width: 95%;
        height: auto;
        margin: 0 10px;
      }
    }
    
    @keyframes modalSlideIn {
      from {
        transform: translateY(50px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }
    {%- endstyle -%}
    
    <div id="newsletterModal" class="modal">
      <div class="modal-content">
        <button class="modal-close" aria-label="Close modal">&times;</button>
        <div class="modal-image">
          <img src="{{ '/newsletter-banner.svg' | asset_url }}" alt="Emordial Character Design, for newsletter" />
        </div>
        <div class="modal-text">
          <h2 class="modal-heading">Subscribe to Our Newsletter</h2>
          <p class="modal-subtitle">
            Join the Emordial family and stay updated with our latest collections and exclusive offers!
          </p>
          <form id="modalNewsletterForm" action="/contact#contact_form" method="post" accept-charset="UTF-8" class="modal-newsletter-form">
            <input type="hidden" name="contact[tags]" value="newsletter" />
            <div class="modal-consent">
              <input type="checkbox" id="privacyConsent" />
              <label for="privacyConsent">
                I agree to the <a href="/privacy-policy" target="_blank">Privacy Policy</a> and <a href="/terms-of-service" target="_blank">Terms of Service</a>.
              </label>
            </div>
            <div class="newsletter-form__field-wrapper1">
              <div class="field">
                <input id="ModalNewsletterForm--modal" type="email" name="contact[email]" class="field__input field-input-custom" aria-required="true" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder=" " required />
                <label for="ModalNewsletterForm--modal" class="newsletter-form__label custom-label-focus">Email</label>
                <button type="submit" class="newsletter-form__button-modal" name="commit" aria-label="Subscribe" disabled></button>
              </div>
            </div>
            <div style="margin: auto; margin-top: 20px;"><span class="no-thank-you-btn">NO, THANK YOU</span></div>
          </form>
        </div>
      </div>
    </div>
    
    <script>
    document.addEventListener("DOMContentLoaded", function () {
      const modal = document.getElementById("newsletterModal");
      const inputField = document.querySelector('.field__input');
      const closeModalBtn = document.querySelector(".modal-close");
      const subscribeButton = document.querySelector(".newsletter-form__button-modal");
      const consentCheckbox = document.getElementById("privacyConsent");
      const label = document.querySelector('.custom-label-focus');
      const noThankYouBtn = document.querySelector(".no-thank-you-btn");
    
      if (!sessionStorage.getItem('newsletterModalShown')) {
        setTimeout(() => {
          modal.style.display = "flex";
          sessionStorage.setItem('newsletterModalShown', 'true');
          document.body.style.overflow = 'hidden';
        }, 6000);
      }
    
      // Close modal function
      function closeModal() {
        modal.style.display = "none";
        document.body.style.overflow = ''; // Restore scrolling
      }
    
      closeModalBtn.addEventListener("click", closeModal);
      noThankYouBtn.addEventListener("click", closeModal);
    
      // Enable submit button when consent is checked
      consentCheckbox.addEventListener("change", function () {
        subscribeButton.disabled = !consentCheckbox.checked;
      });
    
      // Hide modal if the user clicks outside of it
      window.onclick = function (event) {
        if (event.target === modal) {
          closeModal();
        }
      };
    
      // Check input value on blur (when the input loses focus)
      inputField.addEventListener('blur', function () {
        if (inputField.value.trim() !== '') {
          label.classList.add('label-active');
        } else {
          label.classList.remove('label-active');
        }
      });
    });
    </script>
    