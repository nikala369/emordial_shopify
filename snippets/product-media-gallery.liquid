{% comment %}
  Renders a product media gallery.
  Desktop: Vertical image stack with zoom.
  Mobile: Slider carousel with swipe functionality.
{% endcomment %}

{% style %}
/* General Styling */
.global-media-settings-custom {
  border: var(--media-border-width) solid rgba(18, 18, 18, 0.05);
}

.prevent-left-bottom-border {
  border-right: 0px;
  border-bottom: 0px;
}

/* Desktop: Vertical Stacked Media */
@media screen and (min-width: 990px) {
  .media-gallery--vertical-desktop {
    display: flex;
    flex-direction: column;
    gap: 0px;
    /* min-height: 600px; */
  }

  .product__media-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    cursor: default;
    user-select: none;
    opacity: 0;
    transition: opacity 0.3s ease-in-out; /* Smooth fade-in */
  }

  .product__media-item img.lazyloaded {
    opacity: 1; /* Images appear only when loaded */
  }

  .product__media-item {
    display: block;
  }

  .sticky-text-section {
    position: sticky;
    top: 20px;
  }
}

/* Mobile: Fully Restored Carousel */
@media screen and (max-width: 768px) {
  .media-gallery--mobile {
    position: relative;
  }

  .slider--mobile {
    display: flex;
    overflow-x: auto !important;
    scroll-snap-type: x mandatory !important;
    white-space: nowrap;
    gap: 10px;
    scroll-behavior: smooth;
    touch-action: auto;
  }

  .slider--mobile img {
    flex-shrink: 0;
    width: 100%;
    height: auto;
    object-fit: cover;
    scroll-snap-align: center;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .slider--mobile img.lazyloaded {
    opacity: 1;
  }

  .slider--mobile::-webkit-scrollbar {
    display: none;
  }

  /* Navigation Buttons */
  .slider-button {
    position: absolute;
    top: 49.5%;
    transform: translateY(-50%);
    border: none;
    color: #cc0000;
    padding: 8px;
    cursor: pointer;
    z-index: 2;
  }

  .slider-button--prev {
    left: -15px;
    visibility: hidden;
  }

  .slider-button--next {
    right: -15px;
  }

  .custom-ul {
    display: flex;
    padding-left: 15px;
  }
}

/* Hide Elements */
.hidden {
  display: none;
}



/* Fullscreen Modal */
.fullscreen-modal {
  display: none; /* Initially hidden */
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.8); /* Dark overlay */
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
  overflow: hidden;
}

.fullscreen-modal.visible {
  display: block; /* Ensure it's in the layout */
  opacity: 1; /* Make visible */
  visibility: visible; /* Ensure visibility */
  overflow: hidden;
}

.fullscreen-modal.hidden {
  display: none; /* Remove from layout */
  opacity: 0; /* Fade out */
  visibility: hidden;
}

/* Fullscreen Content */
.fullscreen-content {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.fullscreen-content img {
  width: 100%; /* Full width */
  height: 100%; /* Full height */
  object-fit: cover; /* Ensures the image covers the container */
  margin: 0 auto; /* Center the image */
}

.close-fullscreen {
  position: absolute;
  top: 7.5px;
  right: 7.5px;
  color: #cc0000;
  font-size: 28px;
  width: 45px; 
  height: 45px; 
  line-height: 50px;
  display: flex; 
  justify-content: center;
  align-items: center;
  cursor: pointer;
  z-index: 10001;
}

/* Navigation Buttons */


.modal-button--prev {
  left: 10px;
  transform: rotate(90deg);
}

.modal-button--next {
  right: 10px;
  transform: rotate(270deg);
}

/* Disable body scroll when modal is open */
body.modal-open {
  overflow: hidden;
  height: 100%;
}

{% endstyle %}

{%- liquid
  assign media_count = product.media.size
  if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
    assign media_count = media_count | minus: variant_images.size | plus: 1
  endif
-%}

<media-gallery
  id="MediaGallery-{{ section.id }}"
  role="region"
  class="media-gallery"
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>

  <!-- 📱 Mobile Carousel -->
  <div class="media-gallery--mobile hidden">
    <slider-component class="slider slider--mobile custom-slider">
      <ul id="Slider-Gallery-{{ section.id }}" class="product__media-list custom-ul list-unstyled slider">
        {%- for media in product.media -%}
          <li class="product__media-item slider__slide">
            <img
              class="fullscreen-trigger"
              data-src="{{ media | image_url: width: 1200 }}"
              width="800"
              height="auto"
              src="{{ media | image_url: width: 800 }}"
              alt="{{ media.alt | escape }}"
              loading="lazy"
              style="opacity: 0; transition: opacity 0.3s ease-in-out;"
              onload="this.style.opacity=1;">
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>

    <!-- 📍 Navigation Buttons -->
    <div class="slider-button slider-button--prev">{% render 'icon-caret' %}</div>
    <div class="slider-button slider-button--next">{% render 'icon-caret' %}</div>
  </div>

  <!-- 💻 Desktop Vertical Stack -->
  <div class="media-gallery--desktop">
    {%- for media in product.media -%}
      <div class="product__media-item">
        <img
          class="fullscreen-trigger"
          data-src="{{ media | image_url: width: 1200 }}"
          width="1000"
          height="auto"
          src="{{ media | image_url: width: 1000 }}"
          alt="{{ media.alt | escape }}"
          loading="lazy"
          style="opacity: 0; transition: opacity 0.3s ease-in-out;"
          onload="this.style.opacity=1;">
      </div>
    {%- endfor -%}
  </div>
</media-gallery>

<!-- Fullscreen Modal -->
<div id="fullscreen-modal" class="fullscreen-modal hidden">
  <div class="fullscreen-content">
    <span class="close-fullscreen">&times;</span>
    <img id="fullscreen-image" width="390" height="auto" src="" alt="Expanded View">
    <div class="slider-button modal-button--prev">{% render 'icon-caret' %}</div>
    <div class="slider-button modal-button--next">{% render 'icon-caret' %}</div>
  </div>
</div>

<!-- JavaScript for Switching & Modal Functionality -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const mediaGallery = document.getElementById('MediaGallery-{{ section.id }}');
  const desktopGallery = mediaGallery.querySelector('.media-gallery--desktop');
  const mobileGallery = mediaGallery.querySelector('.media-gallery--mobile');
  const prevButton = document.querySelector('.slider-button--prev');
  const nextButton = document.querySelector('.slider-button--next');
  const slider = document.querySelector('.slider--mobile');
  const slides = slider.querySelectorAll('.slider__slide');

  function updateMediaGalleryClass() {
    const isMobile = window.innerWidth < 990;
    if (isMobile) {
      desktopGallery.classList.add('hidden');
      mobileGallery.classList.remove('hidden');
    } else {
      desktopGallery.classList.remove('hidden');
      mobileGallery.classList.add('hidden');
    }
  }

  updateMediaGalleryClass();
  window.addEventListener('resize', updateMediaGalleryClass);

  if (prevButton && nextButton && slider && slides.length > 0) {
    let currentIndex = 0;
    const slideWidth = slides[0].offsetWidth + 10; // Including gap

    function updateButtonVisibility() {
      prevButton.style.visibility = currentIndex === 0 ? 'hidden' : 'visible';
      nextButton.style.visibility = currentIndex === slides.length - 1 ? 'hidden' : 'visible';
    }

    prevButton.addEventListener('click', function () {
      if (currentIndex > 0) {
        currentIndex--;
        slider.scrollTo({ left: currentIndex * slideWidth, behavior: 'smooth' });
      }
      updateButtonVisibility();
    });

    nextButton.addEventListener('click', function () {
      if (currentIndex < slides.length - 1) {
        currentIndex++;
        slider.scrollTo({ left: currentIndex * slideWidth, behavior: 'smooth' });
      }
      updateButtonVisibility();
    });

    // **Fixing Vertical Scroll Issue Inside Slider**
    let startX = 0;
    let startY = 0;
    let isScrollingHorizontally = false;

    slider.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      isScrollingHorizontally = false;
    });

    slider.addEventListener('touchmove', function (e) {
      const moveX = e.touches[0].clientX - startX;
      const moveY = e.touches[0].clientY - startY;

      // If swiping left/right, scroll the slider and block vertical scroll
      if (Math.abs(moveX) > Math.abs(moveY)) {
        e.preventDefault(); // Prevent vertical scroll ONLY for horizontal swipe
        isScrollingHorizontally = true;
        slider.scrollBy({ left: -moveX, behavior: 'smooth' });
      }
    });

    slider.addEventListener('touchend', function (e) {
      if (!isScrollingHorizontally) return;
      const endX = e.changedTouches[0].clientX;

      if (startX - endX > 50 && currentIndex < slides.length - 1) {
        // Swipe left
        currentIndex++;
      } else if (endX - startX > 50 && currentIndex > 0) {
        // Swipe right
        currentIndex--;
      }

      slider.scrollTo({ left: currentIndex * slideWidth, behavior: 'smooth' });
      updateButtonVisibility();
    });

    updateButtonVisibility();
  }

  // **🖼️ Modal Functionality**
  const modal = document.getElementById("fullscreen-modal");
const fullscreenImage = document.getElementById("fullscreen-image");
const closeFullscreen = document.querySelector(".close-fullscreen");
const modalPrev = document.querySelector(".modal-button--prev");
const modalNext = document.querySelector(".modal-button--next");

let currentImageIndex = 0;
let allImages = [];

// Initialize Modal Trigger
document.querySelectorAll(".fullscreen-trigger").forEach((trigger, index) => {
  trigger.addEventListener("click", function () {
    const uniqueSources = new Set(
      Array.from(document.querySelectorAll(".fullscreen-trigger")).map((el) =>
        el.getAttribute("data-src")
      )
    );

    allImages = Array.from(uniqueSources); // Ensure unique images
    currentImageIndex = index;

    updateModalImage();
    // Ensure modal is visible
    modal.classList.remove("hidden");
    modal.classList.add("visible");
    document.body.classList.add("modal-open");
  });
});

// Update Modal Image and Navigation Buttons
function updateModalImage() {
  if (allImages.length > 0) {
    fullscreenImage.src = allImages[currentImageIndex]; // Update modal image
    modalPrev.style.visibility = currentImageIndex === 0 ? "hidden" : "visible"; // Hide "Prev" if at start
    modalNext.style.visibility = currentImageIndex === allImages.length - 1 ? "hidden" : "visible"; // Hide "Next" if at end
  }
}

// Modal Navigation
modalPrev.addEventListener("click", function () {
  if (currentImageIndex > 0) {
    currentImageIndex--;
    updateModalImage();
  }
});

modalNext.addEventListener("click", function () {
  if (currentImageIndex < allImages.length - 1) {
    currentImageIndex++;
    updateModalImage();
  }
});

// Close Modal
function closeModal() {
  modal.classList.remove("visible");
  modal.classList.add("hidden");

  // Add to modal close logic
  modal.classList.remove("visible");
  document.body.classList.remove("modal-open");
}

closeFullscreen.addEventListener("click", closeModal);

modal.addEventListener("click", function (e) {
  if (e.target === modal) {
    closeModal();
  }
});
});
</script>


