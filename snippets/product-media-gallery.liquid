{% comment %}
  Renders a product media gallery.
  Desktop: Vertical image stack with zoom.
  Mobile: Slider carousel with swipe functionality.
{% endcomment %}

{% style %}
  /* General Styling */
  .global-media-settings-custom {
    border: var(--media-border-width) solid rgba(18, 18, 18, 0.05);
  }

  .prevent-left-bottom-border {
    border-right: 0px;
    border-bottom: 0px;
  }

  /* Desktop: Vertical Stacked Media with Zoom */
  @media screen and (min-width: 990px) {
    .media-gallery--vertical-desktop {
      display: flex;
      flex-direction: column;
      gap: 0px; /* Space between images */
    }

    .product__media-item img {
      width: 100%;
      height: auto;
      object-fit: contain;
      cursor: default;
    user-select: none;
    }

    .product__media-item {
      display: block;
    }

    .sticky-text-section {
      position: sticky;
      top: 20px;
    }
  }

 /* Mobile: Fully Restored Carousel */
  @media screen and (max-width: 768px) {
    .media-gallery--mobile {
      position: relative; 
    }

  .slider--mobile {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    white-space: nowrap;
    gap: 10px;
    scroll-behavior: smooth;
    touch-action: pan-x;
  }

  .slider--mobile img {
    flex-shrink: 0;
    width: 100%;
    height: auto;
    object-fit: cover;
    scroll-snap-align: center;
  }

  .slider--mobile::-webkit-scrollbar {
    display: none;
  }

  /* Navigation Buttons */
  .slider-button {
    position: absolute;
    top: 49.5%;
    transform: translateY(-50%);
    border: none;
    color: #cc0000;
    padding: 8px;
    cursor: pointer;
    z-index: 2; /* Ensure buttons are above images */

    &::active {
    color: #cc0000;
    }
  }

  .slider-button--prev {
    left: -15px; 
    visibility: hidden;
  }

  .slider-button--next {
    right: -15px;
  }

  .custom-ul {
    display: flex;
    padding-left: 20px;
  }
}

/* Hide Elements */
.hidden {
  display: none;
}

/* Fullscreen Modal */
.open-fullscreen {
  border: none;
  padding: 0;
  margin: 0;
}
.fullscreen-modal {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.8);
}

.fullscreen-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  max-width: 90%;
}

.fullscreen-content img {
  width: 100%;
  max-height: 90vh;
  object-fit: contain;
}

.close-fullscreen {
  position: absolute;
  top: 10px;
  right: 15px;
  color: white;
  font-size: 24px;
  cursor: pointer;
}
{% endstyle %}

{%- liquid
  assign media_count = product.media.size
  if section.settings.hide_variants and media_count > 1 and variant_images.size > 0
    assign media_count = media_count | minus: variant_images.size | plus: 1
  endif
-%}

<media-gallery
  id="MediaGallery-{{ section.id }}"
  role="region"
  class="media-gallery"
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>

  <!-- Mobile Carousel -->
  <div class="media-gallery--mobile hidden">
    <slider-component class="slider slider--mobile custom-slider">
      <ul id="Slider-Gallery-{{ section.id }}" class="product__media-list custom-ul list-unstyled slider">
        <!-- Media Items -->
        {%- for media in product.media -%}
          <li class="product__media-item slider__slide">
            <div class="open-fullscreen" data-src="{{ media | image_url: width: 1200 }}">
              <img
                width="800"
                height="auto"
                src="{{ media | image_url: width: 800 }}"
                alt="{{ media.alt | escape }}"
                loading="lazy">
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </slider-component>

     <!-- Navigation Buttons -->
     <div class="slider-button slider-button--prev">
      {% render 'icon-caret' %}
    </div>
    <div class="slider-button slider-button--next" name="next">
      {% render 'icon-caret' %}
    </div>
  </div>

  <!-- Desktop Vertical Stack -->
  <div class="media-gallery--desktop">
    {%- for media in product.media -%}
      <div class="product__media-item">
        <img
          width="1000"
          height="auto"
          src="{{ media | image_url: width: 1000 }}"
          alt="{{ media.alt | escape }}"
          loading="lazy">
      </div>
    {%- endfor -%}
  </div>
</media-gallery>


<!-- Fullscreen Modal -->
<div id="fullscreen-modal" class="fullscreen-modal hidden">
  <div class="fullscreen-content">
    <span class="close-fullscreen">&times;</span>
    <img id="fullscreen-image" src="" alt="Expanded View">
  </div>
</div>


<!-- JavaScript for Correct Mobile/Desktop Switching -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  const mediaGallery = document.getElementById('MediaGallery-{{ section.id }}');
  const desktopGallery = mediaGallery.querySelector('.media-gallery--desktop');
  const mobileGallery = mediaGallery.querySelector('.media-gallery--mobile');
  const prevButton = document.querySelector('.slider-button--prev');
  const nextButton = document.querySelector('.slider-button--next');
  const slider = document.querySelector('.slider--mobile');
  const slides = slider.querySelectorAll('.slider__slide');

  function updateMediaGalleryClass() {
    const isMobile = window.innerWidth < 990;
    if (isMobile) {
      desktopGallery.classList.add('hidden');
      mobileGallery.classList.remove('hidden');
    } else {
      desktopGallery.classList.remove('hidden');
      mobileGallery.classList.add('hidden');
    }
  }

  updateMediaGalleryClass();
  window.addEventListener('resize', updateMediaGalleryClass);

  if (prevButton && nextButton && slider && slides.length > 0) {
    let currentIndex = 0;
    const slideWidth = slides[0].offsetWidth + 10; // Including gap

    function updateButtonVisibility() {
      prevButton.style.visibility = currentIndex === 0 ? 'hidden' : 'visible';
      nextButton.style.visibility = currentIndex === slides.length - 1 ? 'hidden' : 'visible';
    }

    prevButton.addEventListener('click', function () {
      if (currentIndex > 0) {
        currentIndex--;
        slider.scrollTo({ left: currentIndex * slideWidth, behavior: 'smooth' });
      }
      updateButtonVisibility();
    });

    nextButton.addEventListener('click', function () {
      if (currentIndex < slides.length - 1) {
        currentIndex++;
        slider.scrollTo({ left: currentIndex * slideWidth, behavior: 'smooth' });
      }
      updateButtonVisibility();
    });

    // Touch gestures for smooth swiping
    let startX = 0;
    let startY = 0;
    let isHorizontalScroll = false;

    slider.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      isHorizontalScroll = false;
    });

    slider.addEventListener('touchmove', function (e) {
      const moveX = e.touches[0].clientX - startX;
      const moveY = e.touches[0].clientY - startY;

      // If horizontal movement is greater than vertical, prevent page scrolling
      if (Math.abs(moveX) > Math.abs(moveY)) {
        e.preventDefault();
        isHorizontalScroll = true;
      } else {
        return; // Allow vertical scrolling naturally
      }
    });

    slider.addEventListener('touchend', function (e) {
      if (!isHorizontalScroll) return;
      const endX = e.changedTouches[0].clientX;
      if (startX - endX > 50 && currentIndex < slides.length - 1) {
        // Swipe left
        currentIndex++;
      } else if (endX - startX > 50 && currentIndex > 0) {
        // Swipe right
        currentIndex--;
      }
      slider.scrollTo({ left: currentIndex * slideWidth, behavior: 'smooth' });
      updateButtonVisibility();
    });

    updateButtonVisibility();
  }
});




</script>



